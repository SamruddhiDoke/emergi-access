# ── Backend (local development without Docker) ─────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://emergi:emergi_dev_password@localhost:5433/emergi_access?schema=public
# Optional — enables Redis-backed rate limiting. Leave blank for in-memory.
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-64-hex-characters
OTP_SECRET=replace-with-64-hex-characters
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173
# Set true whenever the app is served over HTTPS.
COOKIE_SECURE=false
# DEMO_MODE returns simulated OTP codes in API responses. NEVER enable with real users.
DEMO_MODE=true
# Optional fixed demo OTP (e.g. 123456). Blank = random 6-digit code per challenge.
DEMO_OTP=
# Default break-glass authorization length; administrators can change it in-app.
AUTH_DURATION_SECONDS=300
# Used by `npm test` (defaults to emergi_access_test on the compose database).
TEST_DATABASE_URL=postgresql://emergi:emergi_dev_password@localhost:5433/emergi_access_test?schema=public

# ── Docker Compose (root) ───────────────────────────────────────────────────
# Copy to .env to override defaults used by docker-compose.yml.
POSTGRES_USER=emergi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emergi_access
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
FRONTEND_HOST_PORT=8088
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-characters
OTP_SECRET=replace-with-64-hex-characters
SEED_ON_START=true
